{
  "manifest_version": 3,
  "name": "Maps Lead Finder - Auto Scraper",
  "short_name": "Maps Lead Finder",
  "version": "1.1.0",
  "author": "Saim Rauf",
  "description": "One click opens Google Maps beside the scraper, collects highly reviewed businesses with no website, and exports them to Excel.",
  "permissions": ["tabs", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://*.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Start auto scrape"
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
